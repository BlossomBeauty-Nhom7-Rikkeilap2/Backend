# ==============================================================================
# HỆ THỐNG QUẢN LÝ TRUYỀN THÔNG ĐA KÊNH (MULTI-CHANNEL CMS) - NHÓM 7 RIKKEILAB 2
# CẤU HÌNH BIẾN MÔI TRƯỜNG MẪU (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH SERVER & ỨNG DỤNG
# ------------------------------------------------------------------------------
APP_NAME="Multi-Channel Communication Management System"
APP_ENV="development"              # development | staging | production
DEBUG=True
HOST="0.0.0.0"
PORT=8000
API_V1_PREFIX="/api"

# ------------------------------------------------------------------------------
# 2. BẢO MẬT & XÁC THỰC JWT (JSON WEB TOKEN)
# ------------------------------------------------------------------------------
# Khóa bí mật dùng để ký chữ ký số JWT (Khuyến nghị sinh ngẫu nhiên bằng `openssl rand -hex 32`)
SECRET_KEY="rikkeilab_nhom7_multi_channel_cms_super_secret_jwt_key_2026"
ALGORITHM="HS256"
# Thời gian hết hạn Access Token (theo SDD FR-01: 60 phút)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------------------------
# 3. KẾT NỐI CƠ SỞ DỮ LIỆU MYSQL 8.0+
# ------------------------------------------------------------------------------
DB_HOST="localhost"
DB_PORT=3306
DB_NAME="multichannel_cms"
DB_USER="root"
DB_PASSWORD="your_mysql_password"
# Chuỗi kết nối SQLAlchemy (sử dụng driver pymysql)
DATABASE_URL="mysql+pymysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?charset=utf8mb4"

# ------------------------------------------------------------------------------
# 4. CẤU HÌNH LƯU TRỮ TỆP MEDIA (CLOUDFLARE R2 / AWS S3 COMPATIBLE)
# ------------------------------------------------------------------------------
# Dùng để lưu trữ hình ảnh (≤ 10MB) và video ngắn (≤ 50MB) theo Mục 8.2 SRS
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="multichannel-cms-media"
R2_PUBLIC_URL="https://media.multichannel-cms.example.com"
# Thư mục lưu trữ tạm cục bộ khi chạy môi trường dev nếu chưa có tài khoản R2
LOCAL_UPLOAD_DIR="uploads"

# ------------------------------------------------------------------------------
# 5. CẤU HÌNH TÍCH HỢP MẠNG XÃ HỘI (SOCIAL PLATFORMS OAUTH & APIS)
# ------------------------------------------------------------------------------
# Facebook Graph API & Instagram Graph API
FACEBOOK_APP_ID="your_facebook_app_id"
FACEBOOK_APP_SECRET="your_facebook_app_secret"
FACEBOOK_GRAPH_VERSION="v19.0"

# TikTok Business Marketing API
TIKTOK_APP_ID="your_tiktok_app_id"
TIKTOK_APP_SECRET="your_tiktok_app_secret"

# ------------------------------------------------------------------------------
# 6. ĐỒNG BỘ THỜI GIAN THỰC & BỘ ĐỊNH THỜI HỆ THỐNG (SYSTEM TIMER)
# ------------------------------------------------------------------------------
# Chu kỳ quét lịch đăng bài (giây): mặc định 60 giây quét bảng schedules 1 lần
SCHEDULER_INTERVAL_SECONDS=60
# Cho phép Frontend gọi API và kết nối WebSocket (danh sách domain ngăn cách bởi dấu phẩy)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"
